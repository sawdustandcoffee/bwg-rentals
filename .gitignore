# BWG Rentals - Git Ignore

# IDE and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Node.js (if any build tools added)
node_modules/
package-lock.json
yarn.lock

# PHP dependencies (dev only)
composer.lock
# Note: vendor/plugin-update-checker is included in the repo for GitHub updates

# Development/testing
.phpunit.result.cache
phpunit.xml
tests/
coverage/
.coverage
.playwright-mcp/

# Environment files
.env
.env.local
.env.*.local
wp-config.php

# Logs
*.log
debug.log

# Build artifacts
*.zip
dist/

